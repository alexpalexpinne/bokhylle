# Copy to demo/.env for public hosting. The reset script reads this file.
BOKHYLLE_SECURE_COOKIES=true
# For the supplied Caddy example, set true so visitors have separate rate
# limits. Leave false for direct LAN access or an untrusted proxy.
BOKHYLLE_TRUSTED_PROXY=false
# Keep loopback for internet-facing proxy deployments. Set the host's LAN IP
# for a local-network preview without a proxy.
BOKHYLLE_DEMO_BIND=127.0.0.1
BOKHYLLE_DEMO_PORT=8081
