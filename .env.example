# Copy to .env and adjust. Environment variables override database settings.

# Pin an available published release tag or digest.
BOKHYLLE_IMAGE=ghcr.io/alexpalexpinne/bokhylle:v0.4.0

# Server
BOKHYLLE_PORT=8080
BOKHYLLE_BIND_ADDR=0.0.0.0:8080
BOKHYLLE_LOG=info
# Use "json" for structured production logs
BOKHYLLE_LOG_FORMAT=pretty
# Enable when serving over HTTPS so cookies carry the Secure flag
BOKHYLLE_SECURE_COOKIES=false
# Only enable behind a reverse proxy you control: trusts X-Forwarded-For for
# login rate limiting. Leave false for direct LAN access.
BOKHYLLE_TRUSTED_PROXY=false
# Optional daily release awareness; configure in Settings → Server if preferred.
# BOKHYLLE_UPDATE_CHECKS=false

# First-run admin (only used while no users exist).
# Set a strong password (min 8 chars); well-known defaults are refused.
BOKHYLLE_ADMIN_USERNAME=admin
# BOKHYLLE_ADMIN_PASSWORD=

# Comma-free single values; paths inside the container
BOKHYLLE_LIBRARY_DIR=/library
BOKHYLLE_DOWNLOADS_DIR=/downloads
BOKHYLLE_SCAN_ON_STARTUP=true
BOKHYLLE_PREFERRED_FORMAT=epub
BOKHYLLE_PREFERRED_LANGUAGE=en

# Keep looking: automatically retry a request that found no copy yet
BOKHYLLE_RETRIES_ENABLED=true
BOKHYLLE_RETRIES_MAX_DAYS=60

# Host directories (bind mounts; downloads are shared with the sample qBittorrent
# service, which uses BOKHYLLE_UID/BOKHYLLE_GID too)
CONFIG_DIR=./data/config
LIBRARY_DIR=./data/library
DOWNLOADS_DIR=./data/downloads
TZ=UTC

# Optional: run the container as your own host user instead of the baked-in
# uid/gid 10001, useful when bind-mounted directories are owned by you
# BOKHYLLE_UID=1000
# BOKHYLLE_GID=1000

# Optional integration web UIs bind to this host address. Keep loopback unless
# you deliberately need a private LAN address; never forward these ports online.
INTEGRATION_WEB_BIND=127.0.0.1

# Optional acquisition settings; configure these in Settings instead if preferred.
# BOKHYLLE_INDEXER_PROVIDER=newznab
# BOKHYLLE_TORZNAB_URL=http://jackett:9117/api/v2.0/indexers/all/results/torznab/api
# BOKHYLLE_TORZNAB_API_KEY=
# BOKHYLLE_NEWZNAB_URL=https://indexer.example.com/api
# BOKHYLLE_NEWZNAB_API_KEY=
# BOKHYLLE_SABNZBD_URL=http://sabnzbd:8080/api
# BOKHYLLE_SABNZBD_API_KEY=
# BOKHYLLE_SABNZBD_CATEGORY=books-app
# BOKHYLLE_WATCH_ENABLED=true
# BOKHYLLE_WATCH_FOLDER=/config/ingest
